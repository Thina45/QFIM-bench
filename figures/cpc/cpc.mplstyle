# Shared style for Computer Physics Communications revision figures.
# Serif (Times-like) / STIX math, colour-blind-safe (Okabe-Ito) palette, no in-plot titles
# (captions in the paper text; panel letters "(a)"/"(b)" are drawn by each script, not via
# axes.title), 95% CI error bars drawn by each figure script. Vector fonts embedded in PDF.

font.family: serif
font.serif: Times New Roman, Nimbus Roman, STIX, DejaVu Serif, serif
mathtext.fontset: stix
font.size: 8
axes.titlesize: 0
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7

axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', '000000'])

axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.8
xtick.major.width: 0.8
ytick.major.width: 0.8
xtick.direction: out
ytick.direction: out

figure.dpi: 150
savefig.dpi: 600
savefig.bbox: tight
savefig.pad_inches: 0.02
pdf.fonttype: 42
ps.fonttype: 42
figure.constrained_layout.use: True

lines.linewidth: 1.2
lines.markersize: 3.5
errorbar.capsize: 2

legend.frameon: False
